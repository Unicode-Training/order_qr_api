# Cổng HTTP server
PORT=4000
# development | production | test
NODE_ENV=development
# Chuỗi kết nối MongoDB (bắt buộc), ví dụ: mongodb://localhost:27017/order-qr
DATABASE_URL=
# Secret ký JWT (tối thiểu 32 ký tự, đặt giá trị ngẫu nhiên khác nhau)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# Thời hạn token (định dạng: 15m, 1h, 7d ...)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Số vòng băm bcrypt cho mật khẩu (4-15, mặc định 10)
BCRYPT_SALT_ROUNDS=10
# Giới hạn số lần đăng nhập THẤT BẠI trên mỗi IP trong một khoảng thời gian (phút)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Rate limit route /public (khách): cửa sổ (giây), số request/IP, số thao tác ghi (mở phiên/IP, quote/đặt/huỷ đơn/phiên bàn)
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX=600
PUBLIC_WRITE_RATE_LIMIT_MAX=30
# Tự đóng phiên bàn trống (khách quét QR nhưng không đặt món) sau N phút không hoạt động; 0 = tắt
EMPTY_SESSION_TIMEOUT_MINUTES=120
# URL web khách hàng, dùng để in vào mã QR
CLIENT_URL=http://localhost:3000
# Cloudinary — lưu ảnh món ăn/danh mục/nhà hàng (lấy tại https://console.cloudinary.com).
# Để trống thì API upload ảnh trả 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc trên Cloudinary (mặc định: order-qr)
CLOUDINARY_FOLDER=
# Tài khoản đầu tiên do `npm run seed:admin` tạo (chỉ dùng cho script seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_FULLNAME="Quản trị viên"
# Mật khẩu tài khoản nhân viên demo do `npm run seed:demo` tạo (mặc định Demo@123456)
SEED_DEMO_PASSWORD=
